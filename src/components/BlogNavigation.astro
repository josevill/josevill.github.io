---
import { Image } from "astro:assets";
import profileImage from "../assets/profile.jpg";
import { site, blogNavigation } from "../data/resume";
import MdHeading from "./markdown/MdHeading.astro";
import MdNavLink from "./markdown/MdNavLink.astro";

const profileWidths = [208, 320, 416, 832];
const profileSizes = "(min-width: 992px) 26ch, min(70vw, 16rem)";
---

<aside class="md-sidebar" id="sideNav">
  <div class="md-sidebar-sticky">
    <p class="md-line">
      <span class="md-token md-comment">// </span><span
        class="md-token md-filename">{site.shortName}</span
      >
    </p>

    <a class="profile" href="/">
      <p class="md-line">
        <span class="md-token md-bracket">![</span><span
          class="md-token md-link-label">profile</span
        ><span class="md-token md-bracket">](</span><span class="md-token md-url"
          >{site.profileImage}</span
        ><span class="md-token md-bracket">)</span>
      </p>
      <Image
        src={profileImage}
        alt={site.name}
        widths={profileWidths}
        sizes={profileSizes}
        width={416}
        priority
      />
    </a>

    <button
      type="button"
      class="nav-toggle"
      data-nav-toggle
      aria-controls="site-nav"
      aria-expanded="false"
    >
      <span class="md-token md-comment"># </span>toggle menu
    </button>

    <nav class="nav-links" id="site-nav" data-nav-links>
      <MdHeading level={2} as="p">Navigation</MdHeading>
      {
        blogNavigation.map((item) => (
          <MdNavLink href={item.href} label={item.label} scroll={false} />
        ))
      }
    </nav>
  </div>
</aside>

<script src="../scripts/nav.ts"></script>
