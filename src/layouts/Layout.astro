---
import "../styles/global.css";
import { site } from "../data/resume";

interface Props {
	title?: string;
	description?: string;
	ogType?: "website" | "article";
	ogImage?: string;
	ogImageAlt?: string;
	ogImageWidth?: number;
	ogImageHeight?: number;
	publishedTime?: Date;
	modifiedTime?: Date;
	articleAuthor?: string;
	articleTags?: string[];
	jsonLd?: Record<string, unknown> | Record<string, unknown>[];
	/** When true, omit canonical and discourage indexing (404). */
	noindex?: boolean;
}

const DEFAULT_OG_IMAGE = "/og.png";
const DEFAULT_OG_WIDTH = 1200;
const DEFAULT_OG_HEIGHT = 630;
const DEFAULT_OG_TYPE = "image/png";
const DEFAULT_OG_ALT = `${site.shortName} — pseudo online CV and blog`;

const {
	title = site.title,
	description = site.description,
	ogType = "website",
	ogImage = DEFAULT_OG_IMAGE,
	ogImageAlt = DEFAULT_OG_ALT,
	ogImageWidth = DEFAULT_OG_WIDTH,
	ogImageHeight = DEFAULT_OG_HEIGHT,
	publishedTime,
	modifiedTime,
	articleAuthor = site.name,
	articleTags = [],
	jsonLd,
	noindex = false,
} = Astro.props;

const canonicalURL =
	!noindex && Astro.site
		? new URL(Astro.url.pathname, Astro.site)
		: undefined;

const ogImageURL = Astro.site
	? new URL(ogImage, Astro.site).href
	: ogImage;

const jsonLdBlocks = jsonLd
	? Array.isArray(jsonLd)
		? jsonLd
		: [jsonLd]
	: [];
---

<!doctype html>
<html lang="en" data-webtui-theme="catppuccin-mocha">
	<head>
		<meta charset="utf-8" />
		<meta
			name="viewport"
			content="width=device-width, initial-scale=1, shrink-to-fit=no"
		/>
		<meta name="description" content={description} />
		<meta name="author" content={site.author} />
		<meta name="theme-color" content="#1e1e2e" />
		{noindex && <meta name="robots" content="noindex, nofollow" />}

		<!-- Open Graph -->
		<meta property="og:site_name" content={site.shortName} />
		<meta property="og:locale" content="en_US" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:type" content={ogType} />
		<meta property="og:image" content={ogImageURL} />
		<meta property="og:image:secure_url" content={ogImageURL} />
		<meta property="og:image:type" content={DEFAULT_OG_TYPE} />
		<meta property="og:image:width" content={String(ogImageWidth)} />
		<meta property="og:image:height" content={String(ogImageHeight)} />
		<meta property="og:image:alt" content={ogImageAlt} />
		{canonicalURL && <meta property="og:url" content={canonicalURL} />}
		{
			publishedTime && (
				<meta
					property="article:published_time"
					content={publishedTime.toISOString()}
				/>
			)
		}
		{
			modifiedTime && (
				<meta
					property="article:modified_time"
					content={modifiedTime.toISOString()}
				/>
			)
		}
		{
			ogType === "article" && (
				<meta property="article:author" content={articleAuthor} />
			)
		}
		{
			ogType === "article" &&
				articleTags.map((tag) => (
					<meta property="article:tag" content={tag} />
				))
		}

		<!-- Twitter / X -->
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImageURL} />
		<meta name="twitter:image:alt" content={ogImageAlt} />

		{canonicalURL && <link rel="canonical" href={canonicalURL} />}
		{
			Astro.site && (
				<link
					rel="alternate"
					type="application/rss+xml"
					title={`${site.shortName} — Blog`}
					href={new URL("rss.xml", Astro.site)}
				/>
			)
		}
		<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
		<link rel="icon" href="/favicon.ico" sizes="any" />
		<title>{title}</title>
		{
			jsonLdBlocks.map((block) => (
				<script
					is:inline
					type="application/ld+json"
					set:html={JSON.stringify(block)}
				/>
			))
		}
	</head>
	<body id="page-top">
		<a class="skip-link" href="#main-content">Skip to content</a>
		<slot />
	</body>
</html>
